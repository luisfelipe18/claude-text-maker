# .streamlit/secrets.toml
# AWS
AWS_ACCESS_KEY_ID = "AKIA...."
AWS_SECRET_ACCESS_KEY = "H...."
AWS_REGION = "us-east-1"

# S3 overrides (opcional, para no poner en config/config.yaml)
